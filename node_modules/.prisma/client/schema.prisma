// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  phone           String?
  role            String   @default("homeowner") // "homeowner", "landlord", "admin"
  prefectures     String[] // 都道府県 list e.g. ["大阪府", "奈良県"]
  prefecture      String? // primary prefecture of operation
  address         String?
  profileImageUrl String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties               Property[]
  lands                    Land[]
  notifications            Notification[]
  purchaseInquiries        PurchaseInquiry[]
  ownedSaleListingRequests SaleListingRequest[] @relation("SaleListingRequests")
  preference               UserPreference?
  employees                Employee[]           @relation("EmployedBy")
  schedules                Schedule[]
  chatRoomsCreated         ChatRoom[]           @relation("ChatRoomsCreated")
  messagesSent             ChatMessage[]        @relation("MessagesSent")
}

model Property {
  id           String   @id @default(cuid())
  name         String
  address      String
  prefecture   String? // e.g. "大阪府"
  description  String?  @db.Text
  price        Float?
  status       String   @default("draft") // "draft", "for_sale", "sold"
  isPublic     Boolean  @default(false)
  thumbnailUrl String?
  imageUrls    String[]
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseInquiries   PurchaseInquiry[]
  saleListingRequests SaleListingRequest[]
  rooms               Room[]
  schedules           Schedule[]
  chatRooms           ChatRoom[]
}

model Land {
  id           String   @id @default(cuid())
  name         String
  address      String
  prefecture   String? // e.g. "大阪府"
  description  String?  @db.Text
  price        Float?
  status       String   @default("draft") // "draft", "for_sale", "sold"
  isPublic     Boolean  @default(false)
  thumbnailUrl String?
  imageUrls    String[]
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseInquiries   PurchaseInquiry[]
  saleListingRequests SaleListingRequest[]
  schedules           Schedule[]
  chatRooms           ChatRoom[]
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// New models added for purchase inquiry and sale listing request features
// After adding these models, run: npx prisma migrate dev --name add_inquiry_and_sale_request
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseInquiry {
  id          String    @id @default(cuid())
  type        String // "property" or "land"
  propertyId  String?
  landId      String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  land        Land?     @relation(fields: [landId], references: [id], onDelete: Cascade)
  // Sender info (can be non-logged-in user)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  senderName  String
  senderEmail String
  senderPhone String?
  inquiryType String // "purchase" or "consultation"
  message     String    @db.Text
  status      String    @default("pending") // "pending", "replied", "closed"
  adminNote   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SaleListingRequest {
  id           String    @id @default(cuid())
  type         String // "property" or "land"
  propertyId   String?
  landId       String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  land         Land?     @relation(fields: [landId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User      @relation("SaleListingRequests", fields: [ownerId], references: [id])
  askingPrice  Float?
  description  String?   @db.Text
  contactInfo  String?
  thumbnailUrl String?
  imageUrls    String[]
  status       String    @default("pending") // "pending", "approved", "rejected"
  adminNote    String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// New models added for prefecture/regional mode and employee MyNumber features
// Migration: npx prisma migrate dev --name add_prefecture_and_employee_mynumber
// ─────────────────────────────────────────────────────────────────────────────

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayMode          String   @default("nationwide") // "nationwide" or "regional"
  displayPrefectures   String[] // prefectures to show in regional mode (defaults to user.prefectures)
  preferredRegions     String[] // for business opportunity alerts
  notificationSettings Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Employee {
  id                   String    @id @default(cuid())
  ownerId              String // The landlord/homeowner who employs them
  owner                User      @relation("EmployedBy", fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  address              String?
  role                 String? // job role/title
  department           String?
  hireDate             DateTime?
  contractType         String? // "full_time", "part_time", "contract", "temp"
  // MyNumber - stored encrypted (AES-256-GCM)
  mynumber             String? // encrypted MyNumber (12-digit individual number)
  mynumberVerified     Boolean   @default(false)
  mynumberCardFrontUrl String? // URL to front image of mynumber card (stored securely)
  mynumberCardBackUrl  String? // URL to back image of mynumber card
  notes                String?   @db.Text
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  chatRooms ChatRoom[]
}

// ─────────────────────────────────────────────────────────────────────────────
// New models added for room, tenant, family member, payment, and parking features
// Migration: npx prisma migrate dev --name add_room_tenant_payment
// ─────────────────────────────────────────────────────────────────────────────

model Room {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String // e.g. "101号室"
  floor      Int?
  area       Float? // 平米数
  roomType   String? // "1K", "1LDK", "2LDK", etc.
  rentAmount Float?
  status     String   @default("vacant") // "vacant", "occupied", "maintenance"
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenants      Tenant[]
  payments     Payment[]
  parkingSpots ParkingSpot[]
  schedules    Schedule[]
}

model ParkingSpot {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  spotNumber String // e.g. "P-01"
  isOccupied Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Tenant {
  id                           String    @id @default(cuid())
  roomId                       String
  room                         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Basic info
  name                         String
  nameKana                     String? // フリガナ
  email                        String?
  phone                        String?
  // Detailed personal info
  birthDate                    DateTime?
  gender                       String? // "male", "female", "other"
  occupation                   String?
  workplace                    String?
  workplacePhone               String?
  annualIncome                 Float?
  // Emergency contact
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  // Contract info
  moveInDate                   DateTime?
  moveOutDate                  DateTime?
  contractStartDate            DateTime?
  contractEndDate              DateTime?
  rentAmount                   Float?
  depositAmount                Float?
  keyMoneyAmount               Float?
  // Parking info
  parkingUsed                  Boolean   @default(false)
  parkingSpotNumber            String?
  licensePlateNumber           String?
  // Status
  paymentStatus                String    @default("current") // "current", "overdue", "partial"
  status                       String    @default("active") // "active", "moved_out"
  notes                        String?   @db.Text
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  familyMembers FamilyMember[]
  payments      Payment[]
  schedules     Schedule[]
}

model FamilyMember {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  nameKana     String?
  relationship String // "spouse", "child", "parent", "other"
  birthDate    DateTime?
  gender       String?
  occupation   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Payment {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  status        String    @default("pending") // "pending", "paid", "overdue", "partial"
  paymentMethod String? // "bank_transfer", "cash", "auto_debit"
  note          String?
  // MoneyForward連携
  externalId    String? // MoneyForward transaction ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Schedule {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?   @db.Text
  startDateTime     DateTime
  endDateTime       DateTime
  isAllDay          Boolean   @default(false)
  // Category: "inspection", "contract", "maintenance", "payment", "move_in", "move_out", "other"
  category          String    @default("other")
  color             String? // hex color for calendar display
  // Optional links to related entities
  relatedPropertyId String?
  relatedProperty   Property? @relation(fields: [relatedPropertyId], references: [id], onDelete: SetNull)
  relatedLandId     String?
  relatedLand       Land?     @relation(fields: [relatedLandId], references: [id], onDelete: SetNull)
  relatedRoomId     String?
  relatedRoom       Room?     @relation(fields: [relatedRoomId], references: [id], onDelete: SetNull)
  relatedTenantId   String?
  relatedTenant     Tenant?   @relation(fields: [relatedTenantId], references: [id], onDelete: SetNull)
  // Reminder
  reminderMinutes   Int? // minutes before event to remind
  isCompleted       Boolean   @default(false)
  isCancelled       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat models added for in-app messaging feature
// Migration: npx prisma migrate dev --name add_chat
// ─────────────────────────────────────────────────────────────────────────────

enum ChatRoomType {
  land
  property
  employee
}

model ChatRoom {
  id          String        @id @default(cuid())
  type        ChatRoomType
  title       String
  description String?
  landId      String?
  land        Land?         @relation(fields: [landId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation("ChatRoomsCreated", fields: [createdById], references: [id])
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())
}
